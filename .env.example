STOREKEEPER_MONGO_URL=mongodb://localhost:27017/storekeeper
SERVER_PORT=8080
STOREKEEPER_PUBLIC_URL=http://localhost:4200
STOREKEEPER_ALLOWED_ORIGINS=http://localhost:4200
# Local HTTP only. Keep true behind HTTPS outside local development.
SESSION_COOKIE_SECURE=false
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
STOREKEEPER_MAIL_FROM=noreply@localhost
# Production: use your verified sender domain and SMTP credentials.
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# STOREKEEPER_SMTP_AUTH=true
# STOREKEEPER_SMTP_STARTTLS=true
# STOREKEEPER_SMTP_SSL=false
# STARTTLS normally uses port 587; implicit SSL uses 465 (enable SSL instead).
# Enable the google profile only after configuring actual OAuth credentials.
# SPRING_PROFILES_ACTIVE=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
